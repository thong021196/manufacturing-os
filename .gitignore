# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# terraform (infra/terraform/) -- state and var files may contain
# resource details or secrets and must never be committed. *.tf and
# *.tfvars.example are NOT ignored (see the negations below).
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# vercel
.vercel

# local RFQ intake fallback store (dev/test only — never committed, see
# lib/rfq/store/local.ts and .env.example RFQ_LOCAL_STORAGE_DIR)
/.data/

# typescript
*.tsbuildinfo
next-env.d.ts
