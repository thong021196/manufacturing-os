# Copy to .env.local for local development. Never commit a real .env.local
# (see .gitignore's ".env*" rule -- this .env.example file is the one
# explicit exception, committed on purpose so every variable this app
# reads is documented in one place).
#
# You don't need to set ANYTHING here to try the app locally -- with no
# backend env vars set, RFQ submissions use the disk-backed dev/test
# fallback store (lib/rfq/store/local.ts, writes under .data/rfq/,
# gitignored). Set RFQ_BACKEND explicitly to force a specific backend
# regardless of which env vars are present.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# The canonical production https:// URL. Used for canonical/Open Graph
# tags, sitemap.xml/robots.txt and the admin links in alert emails.
# SITE_URL is read at RUNTIME (production sets it on the ECS task);
# NEXT_PUBLIC_SITE_URL is still honoured but Next.js freezes NEXT_PUBLIC_*
# at build time, so prefer SITE_URL. Leave both unset locally.
SITE_URL=
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# RFQ_BACKEND -- which RfqStore implementation to use.
#   "aws"      -- recommended production target (see DEPLOYMENT.md). RDS
#                 Postgres + private S3 bucket.
#   "supabase" -- legacy/alternative production target, still supported.
#   "local"    -- disk-backed dev/test fallback (default when unset and no
#                 backend env vars below are present).
# Leave unset to auto-detect from whichever backend's env vars are set
# below (checks aws, then supabase, then falls back to local).
# ---------------------------------------------------------------------------
RFQ_BACKEND=

# ---------------------------------------------------------------------------
# AWS backend (RFQ_BACKEND=aws) -- see DEPLOYMENT.md + infra/terraform/.
# Provisioned by `terraform apply` in infra/terraform/, then set here (or
# as ECS task-definition environment/secrets in production -- see
# infra/terraform/ecs.tf, which sets these automatically for the deployed
# service; you only need to set these by hand for local testing against a
# real AWS backend).
# ---------------------------------------------------------------------------

# AWS region every manufacturing-os resource lives in.
AWS_REGION=us-east-1

# RDS Postgres connection string for the least-privilege
# manufacturing_os_app role (infra/sql/0001_rfq_intake_rds.sql), e.g.
# postgresql://manufacturing_os_app:<password>@<rds-endpoint>:5432/manufacturing_os
# In production this is injected as a Secrets Manager-backed ECS task
# secret (infra/terraform/secrets.tf, infra/terraform/ecs.tf) -- it is
# NEVER a plaintext GitHub Actions/Vercel env var in production.
DATABASE_URL=

# manufacturing-os-rfq-files-<account-id> -- the private S3 bucket for
# uploaded CAD/drawing/BOM files (infra/terraform/s3.tf). Block Public
# Access is enabled on all four settings; the app only ever reaches it via
# the AWS SDK using the ECS task's IAM role (or your own local AWS
# credentials/profile when testing against a real bucket) -- never a
# static access key committed anywhere.
AWS_S3_RFQ_BUCKET=

# "strict" | "relaxed" (default) | "off" -- RDS TLS certificate
# verification mode for the pg client. See lib/rfq/store/aws.ts's comment
# for the tradeoff "relaxed" (the default) makes at MVP scale.
AWS_DB_SSL=

# ---------------------------------------------------------------------------
# Supabase backend (RFQ_BACKEND=supabase) -- legacy/alternative path, kept
# working but no longer the primary production target (see DEPLOYMENT.md
# "Legacy path: Supabase + Vercel"). Requires a Supabase project + the
# migration in supabase/migrations/0001_rfq_intake.sql applied.
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Server-only secret -- never prefix this NEXT_PUBLIC_, never expose it to
# the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# RFQ intake limits (all optional -- defaults shown; used by every backend)
# ---------------------------------------------------------------------------
RFQ_MAX_FILE_MB=100
RFQ_MAX_FILES=10
RFQ_MAX_TOTAL_MB=300

# Local dev/test fallback store's directory (gitignored). Only read by
# lib/rfq/store/local.ts.
RFQ_LOCAL_STORAGE_DIR=.data/rfq

# ---------------------------------------------------------------------------
# Owner admin (/admin) -- see lib/admin/config.ts and
# docs/ops/LAUNCH-RUNBOOK.md "Admin credentials". In production all four come
# from the `manufacturing-os/admin` Secrets Manager secret (never plaintext
# in the repo, the task definition, or GitHub). With any of the first three
# unset, /admin stays locked.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=
# scrypt hash from `npm run admin:hash-password` -- NEVER the password itself.
ADMIN_PASSWORD_HASH=
# >= 32 random chars (`openssl rand -base64 48`). Rotating it signs everyone out.
ADMIN_SESSION_SECRET=
# Optional: base32 secret from `npm run admin:totp-secret`. When set, a
# 6-digit authenticator code is required at login.
ADMIN_TOTP_SECRET=
# Optional: session lifetime in hours (default 12, max 72).
ADMIN_SESSION_TTL_HOURS=
# Optional: IANA timezone for dates in /admin (default UTC).
ADMIN_TIMEZONE=
# Optional: owner visit days for the "before your next visit" view.
ADMIN_VISIT_DAYS=Mon,Thu

# ---------------------------------------------------------------------------
# New-RFQ email alerts (Amazon SES v2) -- lib/notify/new-rfq.ts. Sent only
# when both are set AND the RFQ backend is not "local"; otherwise a log line.
# Never blocks or fails a customer submission.
# ---------------------------------------------------------------------------
NOTIFY_EMAIL_TO=
SES_FROM_ADDRESS=
# Defaults to AWS_REGION.
SES_REGION=

# Lifetime (seconds, 60-900, default 300) of presigned download links the
# admin gets for customer files.
RFQ_DOWNLOAD_URL_TTL_SECONDS=

# ---------------------------------------------------------------------------
# Content calendar / admin dashboard (optional)
# ---------------------------------------------------------------------------
# Repo + label whose open PRs count as "content waiting for approval".
CONTENT_REPO=thong021196/manufacturing-os
CONTENT_PR_LABEL=content
# Only needed if the repo is private: fine-grained, read-only "Pull requests".
GITHUB_READ_TOKEN=
# Directory for the local (dev) content-overrides JSON (default .data).
CONTENT_OVERRIDES_LOCAL_DIR=
# TEST ONLY: adds /robot-parts/smoke-fixture-* pages (set at build AND start).
CONTENT_SMOKE_FIXTURES=
CONTENT_SMOKE_SOON_AT=

# ---------------------------------------------------------------------------
# Migrations (scripts/migrate.mjs, `npm run migrate`) -- production runs them
# as a one-off ECS task with these injected from Secrets Manager.
# ---------------------------------------------------------------------------
# RDS master connection string (falls back to DATABASE_URL locally).
MIGRATION_DATABASE_URL=
# Password for the manufacturing_os_app role; the runner creates the role /
# syncs its password when set.
DB_APP_PASSWORD=

# Set by the deploy workflow (commit SHA); shown by /api/health and /admin.
APP_VERSION=
